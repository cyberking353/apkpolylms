# ---------------------------------------------------------------------------
# Al-Hikma LMS environment template.
# Copy this file to `.env` on the server and fill in the real values.
# NEVER commit the real `.env` file to git.
# ---------------------------------------------------------------------------

# --- App core ---------------------------------------------------------------
# Set to "true" only during development. The app will refuse to boot with
# DEBUG=false unless DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS are set.
DJANGO_DEBUG=false

# Comma-separated list of hostnames the app serves behind the proxy.
# Example: DJANGO_ALLOWED_HOSTS=alhikmalms.example.com,www.alhikmalms.example.com
DJANGO_ALLOWED_HOSTS=

# Strong random 50+ char value:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# While TLS certificates are NOT yet installed, keep these "false" so the app
# runs over plain HTTP (secure cookies over HTTP would silently break login).
# Flip to "true" (or remove) once HTTPS is live.
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_COOKIES=false

# --- Portal <-> SMS integration (keep identical to the Portal's config) -----
#
# Public base URL of the Portal backend used by `manage.py sync_portal`
# to hit GET /api/v1/lms/sync/init/*.
PORTAL_BACKEND_URL=https://api-demo.auxilax.com

# Bearer token the Portal sends on every /api/v1/sync/* request to the LMS.
LMS_API_TOKEN=change-me

# HMAC-SHA256 secret used to verify the Portal's SSO JWT assertions.
PORTAL_SSO_SECRET=change-me

# --- PostgreSQL (VPS production) --------------------------------------------
# NOTE: under `docker compose` these are overridden automatically
# (DB_HOST=db, DB_PORT=5432) so the container talks to the stack's postgres.
DB_NAME=alhikma_lms
DB_USER=alhikma
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=5

# --- Redis (cache + sessions; REQUIRED by the compose stack) -----------------
# NOTE: under `docker compose` this is overridden to redis://redis:6379/0.
# e.g. redis://:password@127.0.0.1:6379/0
REDIS_URL=

# --- Optional overrides -------------------------------------------------------
# Force local dev to use SQLite instead of Postgres:  DEV_DATABASE=sqlite